# Copy to .env and fill in. Never commit .env or .auth/.

# ---- Target environment (required) ----
TEETIME_BASE_URL=https://dev-booking.teetimeindoorgolf.com
TEETIME_API_URL=https://dev-booking-api.teetimeindoorgolf.com/v1# Booking-creating tests refuse to run unless this is "true" AND the host looks like dev/staging/local.
TEETIME_ALLOW_BOOKING_CREATION=false

# ---- Scenario ----
TEETIME_LOCATION_NAME=Tee Time - Honolulu
# Booking time: not configured. The tests find the first free time at the location (booking 1 hr, reschedule the 2 hr after it).
# Group size after "Update Group Size" (TC4, TC30); must be larger than the booking has (1), max 5
TEETIME_GROUP_SIZE_UPDATE=5
# Quick pick in the "Extend Booking" popup (TC5, TC31, TC39): +30 min, +1 hr, +2 hr or +3 hr (the time after the booking must be free)
TEETIME_EXTEND_BY=+30 min
# Days after "today" (in the location's timezone). The app only lets normal users book today/tomorrow (maxAccessDays = 1).
TEETIME_DAYS_AHEAD=0
# A booking found today must start at least this many minutes from now (reschedule is blocked within 4 h of the start)
TEETIME_MIN_LEAD_MINUTES=270
# Browser timezone. Keep it equal to the location timezone so "Today"/"Tomorrow" labels match the app.
TEETIME_BROWSER_TZ=Pacific/Honolulu

# ---- Auth ----
# signup -> one test user, reused across runs (email remembered in .auth/e2e-user.json): first run signs up a
#           teetime-e2e-<time>@yopmail.com user (login popup -> signup form -> code); later runs only log in with
#           email + code TEETIME_TEST_OTP. Deleted user -> signed up again; blocked user -> a new one is created.
#           Needs the dev backend's fixed test code (TEST_OTP 1111).
# saved  -> reuse the login of TEETIME_TEST_EMAIL saved by `npm run auth` (TEETIME_STORAGE_STATE).
TEETIME_AUTH_MODE=signup
# Same fixed code for every user (= TEST_OTP on the dev backend, e.g. 1111)
TEETIME_TEST_OTP=
TEETIME_SIGNUP_EMAIL_PREFIX=teetime-e2e
TEETIME_SIGNUP_EMAIL_DOMAIN=yopmail.com
TEETIME_SIGNUP_FIRST_NAME=E2E
TEETIME_SIGNUP_LAST_NAME=Tester
# exactly 10 digits
TEETIME_SIGNUP_PHONE=5555550123

TEETIME_TEST_EMAIL=
# Gift card at checkout (TC35–40): a gift card code typed into "Have a gift card?" in Booking Details.
# Headed runs ask you for the code in a popup in Booking Details (empty field: you type it), so leave this empty.
# Only headless runs use this value; empty -> that test is skipped there.
TEETIME_GIFT_CARD_CODE=
TEETIME_STORAGE_STATE=.auth/staging-user.json
# Chrome profile for the test window (Chrome only). Empty = a fresh, empty profile every run (default).
# Set e.g. .auth/chrome-profile, run `npm run chrome:login` once and sign in there yourself (e.g. your Google
# account), close that Chrome: every test run then opens Chrome with that profile, already signed in.
TEETIME_CHROME_PROFILE=

# ---- Payment (Stripe TEST mode on staging: pk_test_) ----
# saved-card  -> use the card already saved on the test account (no card entry)
# test-card   -> type a Stripe published test card into the Stripe Elements
TEETIME_PAYMENT_MODE=test-card
TEETIME_STRIPE_TEST_CARD=
TEETIME_STRIPE_TEST_EXP=
TEETIME_STRIPE_TEST_CVC=
TEETIME_STRIPE_TEST_ZIP=

# ---- Cleanup ----
# true -> cancel each booking the suite created through the app's own cancel endpoint (PATCH /booking/cancel/:id)
TEETIME_CLEANUP=false

# ---- Watching runs ----
# How long (ms) the journey test keeps the confirmation screen and the booked calendar on screen before moving on / closing Chrome.
TEETIME_SHOW_MS=3000
# Booking emails in YopMail (visible runs): wait this long (ms) after each create / reschedule / extend / cancel
# before opening the inbox. Default 1000 (1 s); raise it (e.g. 10000) if YopMail still shows the previous email
TEETIME_EMAIL_ARRIVE_MS=1000
# The same for a NEW booking's email, which takes longer to arrive. Default 8000 (8 s)
TEETIME_NEW_BOOKING_EMAIL_ARRIVE_MS=8000
# npm test (booking flow): pause on each modal so it can be read while watching, in ms. 0 = no pauses
TEETIME_READ_MS=1000
# false -> no YopMail window for the booking emails (default true; visible runs only)
TEETIME_SHOW_EMAILS=true
# true -> fast run: all the pauses above are 0, no drawn cursor and no YopMail window, whatever is set above.
# npm run test:fast sets it for you. The popups that need you (gift card code, wallet in admin) still show
TEETIME_FAST=false

# ---- Browser ----
# Empty = this computer's browser: Google Chrome on Windows / Linux, Safari (WebKit) on macOS. chrome | safari | both
TEETIME_BROWSER=
