{
  "name": "teetime-booking-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E tests for the TeeTime staging bay-booking flow (black-box; no app code changes).",
  "scripts": {
    "auth": "playwright test --project=setup --headed",
    "chrome:login": "node support/chrome-login.js",
    "test": "playwright test tests/main.spec.ts --headed",
    "test:chrome": "playwright test tests/main.spec.ts --headed --project=desktop-chromium",
    "test:safari": "playwright test tests/main.spec.ts --headed --project=desktop-safari",
    "test:fast": "node support/run-fast.js tests/main.spec.ts --headed",
    "test:flow": "playwright test tests/main.spec.ts --grep @card-flow --headed",
    "test:reschedule": "playwright test tests/main.spec.ts --grep @card-quick-shift --headed",
    "test:cancel": "playwright test tests/main.spec.ts --grep @card-refund --headed",
    "test:extend": "playwright test tests/main.spec.ts --grep @card-switch-bay --headed",
    "test:wallet": "playwright test tests/main.spec.ts --grep @wallet-credit --headed",
    "test:wallet-gift-card": "playwright test tests/main.spec.ts --grep @wallet-gift-card --headed",
    "test:gift-card": "playwright test tests/main.spec.ts --grep @gift-card --headed",
    "test:membership": "playwright test tests/main.spec.ts --grep @membership --headed",
    "test:one": "node support/run-one.js --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
